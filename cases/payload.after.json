{
  "openapi": "3.1.1",
  "info": {"title": "Order payload contract", "version": "1.1.0"},
  "paths": {
    "/orders": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {"state": {"type": "string", "enum": ["confirmed"]}}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order accepted",
            "content": {
              "application/json": {
                "schema": {"type": "object", "properties": {"id": {"type": "integer"}}}
              }
            }
          }
        }
      }
    }
  }
}

{
  "openapi": "3.1.1",
  "info": {"title": "Export limits", "version": "1.1"},
  "paths": {
    "/exports": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "limit": {"type": "integer", "minimum": 1, "maximum": 50},
                  "label": {"type": "string", "minLength": 1, "maxLength": 40},
                  "fields": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 10}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Export job created",
            "content": {"application/json": {"schema": {"type": "integer", "minimum": 1, "maximum": 200}}}
          }
        }
      }
    }
  }
}

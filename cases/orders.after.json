{
  "openapi": "3.1.1",
  "info": {"title": "Order access", "version": "1.1.0"},
  "components": {
    "securitySchemes": {
      "account": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://identity.example/token",
            "scopes": {
              "orders:read": "Read orders",
              "orders:write": "Update orders"
            }
          }
        }
      }
    }
  },
  "security": [{"account": ["orders:read"]}],
  "paths": {
    "/orders": {
      "get": {
        "operationId": "listOrders",
        "responses": {"200": {"description": "Orders"}}
      }
    }
  }
}

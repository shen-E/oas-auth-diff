// Generated by node schema/pattern_reference.mjs using ECMAScript RegExp.

///|
test "pattern evaluation agrees with the ECMAScript finite-word oracle" {
  let alphabet = ["a", "b", "0", "-", "\n", "é", "🚀", "猫", " "]
  let words = [""]
  let mut frontier = [""]
  for _ in 0..<3 {
    let next = []
    for prefix in frontier {
      for char in alphabet {
        next.push(prefix + char)
      }
    }
    words.append(next)
    frontier = next
  }
  let extras : Array[Int32] = [
    9, 11, 12, 13, 32, 133, 5760, 6158, 8192, 8202, 8203, 8232, 8233, 8239, 8287,
    12288, 65279, 57344, 65535,
  ]
  for code in extras {
    let word = code.to_char().unwrap().to_string()
    if !words.contains(word) {
      words.push(word)
    }
  }
  let cases : Array[(String, String)] = [
    (
      "", "",
    ),
    (
      "a", "",
    ),
    (
      "^a", "",
    ),
    (
      "a$", "",
    ),
    (
      "^a$", "",
    ),
    (
      "^a|b$", "",
    ),
    (
      "^$", "",
    ),
    (
      "$^", "",
    ),
    (
      "[]", "",
    ),
    (
      "a|", "",
    ),
    (
      "(?:)", "",
    ),
    (
      "[ab]", "",
    ),
    (
      "^[ab]+$", "",
    ),
    (
      "^[a-b]{0,2}$", "",
    ),
    (
      "^[a-]+$", "",
    ),
    (
      "[-a]", "",
    ),
    (
      "[[]", "",
    ),
    (
      "^a{0}$", "",
    ),
    (
      "^a{2,}$", "",
    ),
    (
      "^(a|ab)*$", "",
    ),
    (
      "^(a?)*$", "",
    ),
    (
      "^(ab|b)+$", "",
    ),
    (
      "^a??b?$", "",
    ),
    (
      "a+b*", "",
    ),
    (
      "^\\d\\w?$", "",
    ),
    (
      "\\n$", "",
    ),
    (
      "^\\x61\\u0062$", "",
    ),
    (
      "^\\t?$", "",
    ),
    (
      "^a$|^b$", "",
    ),
    (
      "^((a|b)?)*$", "",
    ),
    (
      "[0-9_]", "",
    ),
    (
      "^a{1,3}?$", "",
    ),
    (
      "^\\^$", "",
    ),
    (
      "a\\$", "",
    ),
    (
      "^[\\d-]+$", "",
    ),
    (
      "[\\b]", "",
    ),
    (
      "a^b", "",
    ),
    (
      "a$b", "",
    ),
    (
      "猫", "",
    ),
    (
      "^猫+$", "",
    ),
    (
      "^[一-龥é]{1,2}$", "",
    ),
    (
      "^\\u732b\\xE9$", "",
    ),
    (
      "\\s", "",
    ),
    (
      "^\\s$", "",
    ),
    (
      "^\\s+$", "",
    ),
    (
      "^[\\s猫]+$", "",
    ),
    (
      "^\\uFEFF$", "",
    ),
    (
      "^é?$", "",
    ),
    (
      "^[\\u0000-\\u007F]+$", "",
    ),
    (
      "^[\\uE000-\\uFFFF]$", "",
    ),
  ]
  for (pattern, bits) in cases {
    let schema = @schema.parse({ "type": "string", "pattern": pattern })
    assert_eq(bits.length(), words.length())
    for index, word in words {
      assert_eq(schema.accepts(Json::string(word)), bits[index] == '1')
    }
  }
}
